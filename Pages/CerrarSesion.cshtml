@page
@model CerrarSesionModel
@{
    ViewData["Title"] = "Cerrar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5 text-center">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <h4>Sesión cerrada</h4>
                <p class="text-muted">Tu sesión fue cerrada correctamente.</p>
                <a asp-page="/Login" class="btn btn-primary">Volver al Login</a>
                <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Ir al Inicio</a>
            </div>
        </div>
    </div>
</div>
