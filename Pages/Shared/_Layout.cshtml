<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asesoría Legal Global</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
    @{
        string? usuarioActual = Context.Session.GetString("usuario");
        bool estaLogueado = !string.IsNullOrEmpty(usuarioActual);
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-principal">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/imagenes/logo1.png" alt="Logo" class="logo-nav" />
                    Asesoría Legal Global
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>

                        @if (!estaLogueado)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Registro">Registro</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Login</a>
                            </li>
                        }

                        @if (estaLogueado)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/MisDocumentos">Mis Documentos</a>
                            </li>
                            <li class="nav-item nav-usuario">
                                <a class="nav-link text-warning" asp-page="/MisDocumentos">@usuarioActual</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/CerrarSesion">Cerrar Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer-principal mt-5">
        <div class="container text-center py-3">
            <img src="~/imagenes/logo2.png" alt="Logo" class="logo-footer" />
            <p class="mb-0 mt-2">© 2024 Asesoría Legal Global. Todos los derechos reservados.</p>
            <p class="mb-0">Av. Corrientes 1234, Buenos Aires &nbsp;|&nbsp; Tel: (011) 4567-8900 &nbsp;|&nbsp; legal@asesorialegalglobal.com</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
