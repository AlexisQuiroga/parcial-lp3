@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="text-danger">Ocurrió un error.</h1>
    <p class="text-muted">No se pudo procesar la solicitud. Por favor intentá de nuevo.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>ID de solicitud:</strong> <code>@Model.RequestId</code></p>
    }

    <a asp-page="/Index" class="btn btn-primary mt-3">Volver al inicio</a>
</div>
